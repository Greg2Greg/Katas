{
  "name": "kata",
  "version": "1.0.0",
  "type": "module",
  "description": "each folder contains different kata",
  "main": "index.js",
  "scripts": {
    "serve:mini-clean-app": "node --experimental-strip-types Effect/mini-clean-app/server.ts",
    "test:watch": "NODE_OPTIONS='--unhandled-rejections=throw' vitest --watch",
    "test": "NODE_OPTIONS='--unhandled-rejections=throw' vitest --coverage",
    "test:mutant": "NODE_OPTIONS='--unhandled-rejections=throw' stryker run",
    "build": "tsc --noEmit",
    "build:effect": "tsc -p Effect/tsconfig.json"
  },
  "author": "Gregory Richert",
  "license": "ISC",
  "engines": {
    "npm": "10.9.2",
    "node": "22.17.0"
  },
  "dependencies": {
    "@effect/sql": "^0.51.0",
    "@effect/sql-pg": "^0.52.1",
    "@hono/node-server": "^1.15.0",
    "argon2": "0.43.0",
    "arktype": "^2.1.20",
    "commander": "^14.0.0",
    "effect": "^3.21.0",
    "fast-check": "^4.9.0",
    "fastify": "^5.3.3",
    "hono": "^4.8.3",
    "inquirer": "^12.6.3",
    "pg": "^8.20.0",
    "ts-essentials": "^10.1.1",
    "uuid": "^11.1.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@testcontainers/postgresql": "^11.1.0",
    "@types/node": "20.3.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "5.59.7",
    "@typescript-eslint/parser": "5.59.7",
    "@vitest/coverage-v8": "3.2.4",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "8.42.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "stryker-cli": "^1.0.2",
    "testcontainers": "^11.1.0",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
